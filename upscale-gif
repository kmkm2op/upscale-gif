        -f rawvideo -pix_fmt rgb24 - 2>/dev/null | od -An -tu1 -v -w$((cw * 3)) | awk -v w="$cw" -v h="$ch" -v cx="$cx" -v cy="$cy" "$FOURIER_AWK"'
