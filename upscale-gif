# Order of the model list, and the default (the first one available)
MODEL_ORDER=(upscayl-standard-4x upscayl-lite-4x digital-art-4x high-fidelity-4x
    realesr-animevideov3-x4 realesr-animevideov3-x3 realesr-animevideov3-x2
    RealESRGAN_General_WDN_x4_v3 4x_NMKD-Siax_200k 4xLSDIR 4xLSDIRplusC 4xLSDIRCompactC3
    4xNomos8kSC 4x_NMKD-Superscale-SP_178000_G remacri-4x ultrasharp-4x ultramix-balanced-4x
    uniscale_restore realesrgan-x4plus RealESRGAN_General_x4_v3 realesrgan-x4plus-anime
    4xHFA2k)
# Not an AI model: plain nearest-neighbour scaling, which keeps pixel art's hard edges
NEAREST=nearest
NEAREST_DESC="Pixel art: nearest neighbour, sharp square pixels (no AI, no GPU needed)"
declare -A FMT_DESC=(
    [gif]="GIF" [webm]="WebM (VP9, keeps transparency and audio)"
    [avif]="AVIF (AV1, keeps transparency)" [mp4]="MP4 (H.264, keeps audio, no transparency)"
    [png]="PNG (lossless, keeps transparency)" [jpg]="JPEG (small, no transparency)"
    [webp]="WebP (keeps transparency)"
)
ANIM_FORMATS=(gif webp webm avif mp4)
IMAGE_FORMATS=(png jpg webp avif gif)   # offered when the input is a single image
