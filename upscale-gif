            if (!grid(ex, w, X, 220, 1600) || !grid(ey, h, Y, 220, 1600)) exit
            # A clear grid, the same size both ways (photos, video and dithering have none)
            if (X["s"] < 0.3 || Y["s"] < 0.3 || abs(X["p"] - Y["p"]) > 0.05 * X["p"]) exit
