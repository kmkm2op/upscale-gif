#!/usr/bin/env bash
# Upscale an animation, video or image (gif, mp4, webm, avif, webp, apng, mkv, mov, png, jpg...)
# with Upscayl and save it as gif, webp, mp4, webm or avif (images also as png or jpg).
#
# Usage: upscale-gif [-m model] [-w width | -H height] [-f format] [-q quality%] [-d downsampler]
#                    [-g gpu] [-t disk|ram] [-o output] [input]
#        upscale-gif -c    (show detected tools, models and GPUs)
# Anything not given on the command line is asked for in a settings window. Formats: gif, webp,
# mp4, webm, avif, and for single images png, jpg. -q: 1-100 (default 80; ignored for png).
# Frames are upscaled by the model, then downsampled to the chosen size with -d: lanczos
# (default), spline, bicubic or area. Every frame keeps its original timing, and audio is kept
# for mp4/webm output. -m nearest is nearest-neighbour scaling for pixel art: no AI and no
# GPU, whole multiples (2x, 3x...) of the size. -t: where the temporary frames go, disk (the
# default) or ram (only if they fit in half the available memory; the settings window offers
# it then).
# Made for GIFs, short clips and images; long videos are better served by a video upscaler
# such as Video2X or REAL Video Enhancer.
#
# Requirements: bash 4+, GNU coreutils, a Vulkan GPU driver and, for the dialogs, zenity
# (kdialog is used for the file picker when available). The release packages include
# Upscayl's upscaler, models and ffmpeg in bin/ and models/ next to this script; without
# them it uses ffmpeg/ffprobe 7+ (8+ for animated WebP input) from PATH and an installed
# Upscayl (distro package, .deb/.rpm, Snap, Flatpak). python3 is used to read Upscayl's
# own settings (custom models folder, GPU ID); without it they are ignored.
# To use another Upscayl install set UPSCAYL_BIN (path to upscayl-bin) and optionally
# UPSCAYL_MODELS (folder of .param/.bin models).
# An AppImage can be used after extracting it: ./Upscayl.AppImage --appimage-extract,
# then UPSCAYL_BIN=squashfs-root/resources/bin/upscayl-bin.
# Custom models come from the folder chosen in Upscayl (Settings > Custom models folder),
# or from UPSCAYL_CUSTOM_MODELS. The GPU is -g, else Upscayl's GPU ID setting, else auto.

set -euo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/upscale-gif.conf
WORKROOT=${XDG_CACHE_HOME:-$HOME/.cache}
RAMROOT=/dev/shm
temp=""
model="" format="" width="" height="" output="" input="" gpu="" quality="" downsampler=""
# Release packages carry upscayl-bin, ffmpeg and ffprobe in bin/ and the models in models/
SELF_DIR=$(dirname "$(realpath "$0")")
BUNDLE_BIN=$SELF_DIR/bin
[[ -x $BUNDLE_BIN/ffmpeg && -x $BUNDLE_BIN/ffprobe ]] && PATH=$BUNDLE_BIN:$PATH

declare -A DESC=(
