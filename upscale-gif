            for (x = 0; x < w; x++) { c = rx[x]; o = o ((c >= 0 && ((r, c) in G)) ? RP[y, x] : "00000000") }
            print toupper(o) > ofile3 }
        for (j = 0; j < oh; j++) {
            if (!nu) { print clear > ofile; continue }
            o = ""
            # (not where it would cover any of the third layer)
            for (i = 0; i < ow; i++) { hit = ""; k = 0
                for (r = or0[j]; r <= or1[j]; r++) for (c = oc0[i]; c <= oc1[i]; c++) if ((r, c) in G) k = 1; else if (hit == "" && ((r, c) in U)) hit = r SUBSEP c
                if (hit == "" || k) { o = o "00000000"; continue }
                col = ocell(i, j); o = o (col == "" ? B[hit] : col) }
            print toupper(o) > ofile } }'
# fraction P Q p q: "A B" where grid p by q is A/B of grid P by Q (B up to 8, within 1%), or
# "0 1"
fraction() {
    awk -v P="$1" -v Q="$2" -v p="$3" -v q="$4" 'BEGIN {
        r = (p + q) / (P + Q)
        for (b = 1; b <= 8; b++) { a = int(r * b + 0.5); e = a / b - r; if (e < 0) e = -e
            if (a >= 1 && e <= 0.01 * r) { print a, b; exit } }
        print 0, 1 }'
}
# grid_learn W H P Q FX FY BW BH < od rows of some frames: "GRID2 size_x size_y offset_x
# offset_y strength_x strength_y" for a second grid (only "GRID2" if there is none), then
# "FROM TO COUNT" for every colour, nearly identical colours (RGB differences adding up to
# 18 or less, same transparency) mapping to the most common of them
grid_learn() {
    awk -v w="$1" -v h="$2" -v P="$3" -v Q="$4" -v fx="$5" -v fy="$6" -v bw="$7" -v bh="$8" -v learn=1 "$FOURIER_AWK$GRID_AWK"'
        BEGIN { cells() }
        { pixels((NR - 1) % h, 0) }
        END { endframe(); printf "GRID2"
            # Enough clustered, badly explained cells (0.2%) and a clear grid in them, the
            # same size both ways
            if (ncand >= 0.002 * frames * bw * bh && grid(ex, w, X, 150, 1600) && grid(ey, h, Y, int(X["p"] * 90), int(X["p"] * 110))) {
                if (X["f"] >= 0.8 * X["p"]) X["f"] -= X["p"]; if (Y["f"] >= 0.8 * Y["p"]) Y["f"] -= Y["p"]
                printf " %.3f %.3f %.3f %.3f %.3f %.3f", X["p"], Y["p"], X["f"], Y["f"], X["s"], Y["s"] }
            print ""; for (c in n) print n[c], c }' | {
        read -r line; echo "$line"
        sort -k1,1nr -k2,2 | awk "$GRID_AWK"'
            { c = $2; into = ""; bd = 19
              for (i = 1; i <= k; i++) if (substr(kept[i], 7, 2) == substr(c, 7, 2)) { v = dist(c, kept[i]); if (v < bd) { bd = v; into = kept[i] } }
              if (into == "") { kept[++k] = c; into = c }
              print c, into, $1 }'
    }
}
# grid_frame_learn MAP W H P Q FX FY BW BH P2 Q2 GX GY OW OH < od rows of some frames:
# "GRID3 size_x size_y offset_x offset_y" for a third grid around the second layer that
# explains it clearly better (only "GRID3" if there is none)
grid_frame_learn() {
    awk -v w="$2" -v h="$3" -v P="$4" -v Q="$5" -v fx="$6" -v fy="$7" -v bw="$8" -v bh="$9" -v ov=1 -v flearn=1 \
        -v P2="${10}" -v Q2="${11}" -v gx="${12}" -v gy="${13}" -v ow="${14}" -v oh="${15}" "$GRID_AWK"'
        BEGIN { cells() }
        NR == FNR { to[$1] = $2; tot[$2] += $3; next }
        { pixels((FNR - 1) % h, 1) }
        END { endframe(); printf "GRID3"
            # The best one (the first of equals), if it leaves the badly explained colours at
            # least 10% lower
            for (g = 1; g <= ng; g++) if (!b || FT[g] < FT[b]) b = g
            if (b && FT[b] < 0.9 * FB) printf " %.3f %.3f %.3f %.3f", GP[b], GQ[b], GX[b], GY[b]
            print "" }' "$1" -
}
# grid_restore MAP W H P Q FX FY BW BH [P2 Q2 GX GY OW OH OFILE [P3 Q3 HX HY OW3 OH3 OFILE3]]
# < od rows: the restored frames in hex, and with a second grid its layer in hex in OFILE
# (and with a third one, the frame it marks in OFILE3, at the source size)
grid_restore() {
    local o=(-v ov=0); (( $# > 9 )) && o=(-v ov=1 -v P2="${10}" -v Q2="${11}" -v gx="${12}" -v gy="${13}" -v ow="${14}" -v oh="${15}" -v ofile="${16}")
    (( $# > 16 )) && o+=(-v ov3=1 -v P3="${17}" -v Q3="${18}" -v hx="${19}" -v hy="${20}" -v ow3="${21}" -v oh3="${22}" -v ofile3="${23}")
    awk -v w="$2" -v h="$3" -v P="$4" -v Q="$5" -v fx="$6" -v fy="$7" -v bw="$8" -v bh="$9" "${o[@]}" "$GRID_AWK"'
        BEGIN { cells() }
        NR == FNR { to[$1] = $2; tot[$2] += $3; next }
        { pixels((FNR - 1) % h, 1) }
        END { endframe() }' "$1" -
}
# The input's frames as RGBA hex rows (od), every STEP-th frame, at most MAX of them
frames_hex() {   # frames_hex STEP MAX
    local f=("-map" "0:$vidx" -vf "select=not(mod(n\,$1))" -pix_fmt rgba)
    [[ -z $aidx ]] || f=(-filter_complex "[0:$vidx][0:$aidx]alphamerge,format=rgba,select=not(mod(n\,$1))")
    ffmpeg -nostdin -v error -i "$input" "${f[@]}" -fps_mode passthrough -frames:v "$2" -f rawvideo -pix_fmt rgba - \
        | od -An -tx1 -v -w$((src_w * 4))
}
# place P2 Q2 GX GY OW OH A B: "width height x y" of a layer at the output size ($scale per
# main cell), with whole pixels of scale x A/B if A isn't 0. It is placed by its middle, where
# the rounding of its size matters least.
place() {
    awk -v s="$scale" -v P="${grid_args[2]}" -v Q="${grid_args[3]}" -v fx="${grid_args[4]}" -v fy="${grid_args[5]}" \
        -v p="$1" -v q="$2" -v gx="$3" -v gy="$4" -v ow="$5" -v oh="$6" -v a="$7" -v b="$8" \
        'function r(v) { return v < 0 ? -int(-v + 0.5) : int(v + 0.5) }
         BEGIN { if (a) { t = s * a / b; w = ow * t; h = oh * t } else { w = r(ow * p * s / P); h = r(oh * q * s / Q) }
             print w, h, r((gx + ow * p / 2 - fx) * s / P - w / 2), r((gy + oh * q / 2 - fy) * s / Q - h / 2) }'
}
# restore_frames: turns the extracted frames into the art's original pixels ($work/upscaled)
# and the second layer, if any ($work/layer)
restore_frames() {
    local a=("${grid_args[@]}")
    (( ${#layer_args[@]} )) && a+=("${layer_args[@]}" "$work/layer.hex")
    (( ${#frame_args[@]} )) && a+=("${frame_args[@]}" "$work/frame.hex")
    ffmpeg -nostdin -v error -i "$work/frames/%06d.png" -f rawvideo -pix_fmt rgba - \
        | od -An -tx1 -v -w$((src_w * 4)) | grid_restore "$work/colours.txt" "${a[@]}" | basenc --base16 -d \
        | ffmpeg -nostdin -v error -f rawvideo -pix_fmt rgba -s "${base_w}x$base_h" -i - -start_number 1 "$work/upscaled/%06d.png" || return
    if (( ${#layer_args[@]} )); then
        mkdir -p "$work/layer"
        basenc --base16 -d <"$work/layer.hex" | ffmpeg -nostdin -v error -f rawvideo -pix_fmt rgba \
            -s "${layer_args[4]}x${layer_args[5]}" -i - -start_number 1 "$work/layer/%06d.png" || return
        rm -f "$work/layer.hex"
    fi
    if (( ${#frame_args[@]} )); then
        mkdir -p "$work/frame"
        basenc --base16 -d <"$work/frame.hex" | ffmpeg -nostdin -v error -f rawvideo -pix_fmt rgba \
            -s "${src_w}x$src_h" -i - -start_number 1 "$work/frame/%06d.png" || return
        rm -f "$work/frame.hex"
    fi
}
# Bytes the temporary frames may take in RAM ($RAMROOT, a tmpfs): half of the memory that is
# available, so the rest of the system (a game, the encoders) keeps plenty, and never more
# than the tmpfs has free. RAM is only used when chosen.
ram_room() {
    local avail shm room
    [[ -d $RAMROOT && -w $RAMROOT && $(stat -f -c %T "$RAMROOT" 2>/dev/null) == tmpfs ]] || { echo 0; return; }
    avail=$(awk '/^MemAvailable:/ { print $2 * 1024 }' /proc/meminfo 2>/dev/null)
    shm=$(df --output=avail -B1 "$RAMROOT" 2>/dev/null | tail -1)
    [[ $avail =~ ^[0-9]+$ && $shm =~ ^[0-9]+$ ]] || { echo 0; return; }
    room=$(( avail / 2 ))
    (( room <= shm - 256 * 1024 ** 2 )) || room=$(( shm - 256 * 1024 ** 2 ))
    echo $(( room > 0 ? room : 0 ))
}
# Picks RAM (if chosen with -t, else last time, and it fits) or disk for $need bytes
# (temp_where), and describes it (space_note)
choose_temp() {
    temp_root=$WORKROOT temp_where=disk
    if [[ ${temp:-$last_temp} == ram ]] && (( need <= $(ram_room) )); then
        temp_root=$RAMROOT temp_where=RAM
        space_note="Needs ~$(human "$need") of temporary space, kept in RAM"
    else
        space_note="Needs ~$(human "$need") of temporary space on disk ($(human "$free") free)"
    fi
}
# Added to errors: a full tmpfs makes the tools fail with unclear messages
ram_hint() {
    [[ ${temp_where:-} == RAM ]] || return 0
    (( $(df --output=avail -B1 "$RAMROOT" | tail -1) > 64 * 1024 ** 2 )) \
        || echo " (the temporary space in RAM ran out; try -t disk)"
}

while getopts "m:w:H:f:q:d:g:t:o:ch" opt; do
    case $opt in
        m) model=$OPTARG ;;
        w) width=$OPTARG ;;
        H) height=$OPTARG ;;
        f) format=${OPTARG,,}; [[ $format != jpeg ]] || format=jpg ;;
        q) quality=${OPTARG%\%} ;;
        d) downsampler=${OPTARG,,} ;;
        o) output=$OPTARG ;;
        g) gpu=${OPTARG,,} ;;
        t) temp=${OPTARG,,} ;;
        c) check; exit ;;
        h) sed -n '5,/^#$/{/^#$/d; s/^# \{0,1\}//p}' "$0"; exit 0 ;;
        *) exit 1 ;;
    esac
done
shift $((OPTIND - 1))
input=${1:-}

# The output name's extension picks the format when -f isn't given
out_ext=${output##*.}; out_ext=${out_ext,,}; [[ $out_ext != jpeg ]] || out_ext=jpg
if [[ -n $output && $out_ext =~ ^(gif|mp4|webm|avif|png|jpg|webp)$ ]]; then
    [[ -z $format || $format == "$out_ext" ]] || die "output name ends in .$out_ext but the format is $format"
    format=$out_ext
fi

for f in ffmpeg ffprobe numfmt; do have $f || die "$f is required but not installed"; done
[[ -z $gpu || $gpu =~ ^(auto|[0-9]+(,[0-9]+)*)$ ]] || die "GPU must be auto, a number or a list like 0,1 (see -c)"
# Check the upscaler and GPU before asking for anything, rather than failing after extracting
# the frames. Without them only nearest-neighbour scaling is possible.
upscaler_error=""
if [[ $model != "$NEAREST" ]]; then
    upscaler_error=$(bundle_error)
    [[ -n $upscaler_error || -n $UPSCAYL ]] \
        || upscaler_error="Upscayl not found. Install it, or set UPSCAYL_BIN to the path of upscayl-bin (run with -c for details)."
    [[ -n $upscaler_error || -n $MODELS ]] || upscaler_error="found $UPSCAYL but no models folder next to it; set UPSCAYL_MODELS"
    if [[ -z $upscaler_error ]]; then load_gpus; (( ${#GPU_LIST[@]} )) || upscaler_error=$NO_GPU_HELP; fi
fi
if [[ -n $upscaler_error ]]; then
    [[ -z $model ]] || die "$upscaler_error
(-m $NEAREST, nearest neighbour for pixel art, works without it.)"
    # The settings window then offers only nearest neighbour, and says why
    MODEL_DIR=([$NEAREST]=-) MODEL_LIST=()
fi
for g in ${gpu//,/ }; do
    (( ${#GPU_LIST[@]} )) || break
    [[ $g == auto ]] || printf '%s\n' "${GPU_LIST[@]%% *}" | grep -qx "$g" \
        || die "there is no GPU $g. Available: $(printf '%s; ' "${GPU_LIST[@]}" | sed 's/; $//')"
done
gpu_warn=""
for line in "${GPU_LIST[@]}"; do software_gpu "$line" || { gpu_warn=x; break; }; done
[[ -n $gpu_warn || ${#GPU_LIST[@]} == 0 ]] && gpu_warn="" \
    || gpu_warn="Only a software Vulkan driver was found (${GPU_LIST[0]#* }): upscaling runs on the CPU and is very slow. Install your graphics card's Vulkan driver to use the GPU."
[[ -z $quality ]] || { [[ $quality =~ ^[0-9]+$ ]] && (( quality >= 1 && quality <= 100 )); } || die "quality must be 1 to 100"
[[ -z $downsampler || " ${DOWNSAMPLERS[*]} " == *" $downsampler "* ]] || die "downsampler must be one of: ${DOWNSAMPLERS[*]}"
[[ -z $temp || $temp =~ ^(ram|disk)$ ]] || die "-t must be disk or ram"

# Remembered choices from the last run
last_model="" last_format=gif last_image_format="" last_quality=80 last_downsampler=lanczos last_temp=disk last_dir=$HOME
[[ -f $CONF ]] && source "$CONF"
if [[ -z $last_model || -z ${MODEL_DIR[$last_model]:-} ]]; then
    last_model=${MODEL_LIST[0]:-}
    for m in "${MODEL_ORDER[@]}"; do [[ -z ${MODEL_DIR[$m]:-} ]] || { last_model=$m; break; }; done
fi

# --- Choose file -------------------------------------------------------------------
if [[ -z $input ]]; then
    gui || die "no input file given (and no desktop session for a file picker)"
    [[ -d $last_dir ]] || last_dir=$HOME
    input=$(pick_file) || exit 0
fi
[[ -f $input ]] || die "file not found: $input"
# Absolute path, so a name starting with "-" isn't taken for an option
input=$(realpath -- "$input")

# --- Probe -------------------------------------------------------------------------
# Use the video stream with the most frames: AVIF files also carry a still image (and
# alpha) as separate streams, and the animation is the longer one.
vidx="" aidx="" best=-1
while IFS='|' read -r idx frames; do
    [[ $frames =~ ^[0-9]+$ ]] || frames=0
    if (( frames > best )); then best=$frames vidx=$idx; fi
done < <(ffprobe -v error -select_streams v -show_entries stream=index,nb_frames -of csv=p=0:s='|' "$input")
[[ -n $vidx ]] || die "no video found in $(basename "$input")"

# Animated AVIF keeps transparency in a second track with the same frame count
brand=$(ffprobe -v error -show_entries format_tags=major_brand -of csv=p=0 "$input")
if [[ $brand == avi[fs] ]] && (( best > 0 )); then
    aidx=$(ffprobe -v error -select_streams v -show_entries stream=index,nb_frames -of csv=p=0:s='|' "$input" \
        | awk -F'|' -v v="$vidx" -v n="$best" '$1 > v && $2 == n { print $1; exit }')
fi

src_w=0 src_h=0 avg_rate="" sar="" rotation=0
while IFS='=' read -r key value; do
    case $key in
        width) src_w=$value ;; height) src_h=$value ;; avg_frame_rate) avg_rate=$value ;;
        sample_aspect_ratio) sar=$value ;; rotation) rotation=${value%.*} ;;
    esac
done < <(ffprobe -v error -select_streams "$vidx" -of default=nw=1 \
    -show_entries stream=width,height,avg_frame_rate,sample_aspect_ratio:stream_side_data=rotation "$input")
