# ffmpeg filters for resizing the model's output to the chosen size
DOWNSAMPLERS=(lanczos spline bicubic area)
declare -A DOWNSAMPLER_DESC=(
    [lanczos]="Sharpest (default)"
    [spline]="Sharp, fewer halos around edges"
    [bicubic]="Softer, smooth"
    [area]="Pixel averaging, no halos; softest, good for big reductions"
)

have() { command -v "$1" >/dev/null 2>&1; }
gui() { [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && have zenity; }
die() {
    declare -F progress_close >/dev/null && progress_close
    echo "upscale-gif: $*" >&2
    if [[ ! -t 2 ]] && gui; then zenity --error --title="Upscale GIF" --text="$*" 2>/dev/null || true; fi
    exit 1
}

# --- Locate Upscayl ---------------------------------------------------------------------
# upscayl-bin is Upscayl's command-line upscaler; its -z (model scale) option tells it
# apart from other Real-ESRGAN builds with a similar interface.
is_upscayl() {
    local out
    [[ -f $1 && -x $1 ]] || return 1
    out=$(timeout 10 "$1" -h 2>&1) || true    # -h exits non-zero
    [[ $out == *"-z model-scale"* ]]
}
# find_upscayl [installed]: the bundled upscayl-bin comes first unless "installed" is given
find_upscayl() {
    local c bundled
    bundled=$(realpath -m "$BUNDLE_BIN/upscayl-bin")
    if [[ -n ${UPSCAYL_BIN:-} && -z ${1:-} ]]; then
        is_upscayl "$UPSCAYL_BIN" || return 1
        realpath "$UPSCAYL_BIN"; return
    fi
    for c in "$bundled" "$(command -v upscayl-bin 2>/dev/null)" "$(command -v upscayl-ncnn 2>/dev/null)" \
        /usr/share/upscayl/bin/upscayl-bin /usr/lib/upscayl/resources/bin/upscayl-bin \
        /opt/Upscayl/resources/bin/upscayl-bin /opt/upscayl/resources/bin/upscayl-bin \
        /snap/upscayl/current/resources/bin/upscayl-bin \
        $(find /var/lib/flatpak/app/org.upscayl.Upscayl "$HOME/.local/share/flatpak/app/org.upscayl.Upscayl" \
            -path '*/active/*' -name upscayl-bin -type f 2>/dev/null); do
        [[ -n $c ]] || continue
        [[ -n ${1:-} && $(realpath -m "$c") == "$bundled" ]] && continue
        is_upscayl "$c" && { realpath "$c"; return; }
    done
    return 1
}
# Models live beside the binary in every Upscayl layout (bin/ and models/ share a parent)
find_models() {
    local d base
    if [[ -n ${UPSCAYL_MODELS:-} ]]; then echo "$UPSCAYL_MODELS"; return; fi
    base=$(dirname "$1")
    for d in "$base/../models" "$base/models" "$base/../resources/models" "$base/../share/upscayl/models" \
        /usr/share/upscayl/models; do
        compgen -G "$d/*.param" >/dev/null && { realpath "$d"; return; }
    done
    return 1
}
UPSCAYL=$(find_upscayl) || UPSCAYL=""
MODELS=""
[[ -n $UPSCAYL ]] && MODELS=$(find_models "$UPSCAYL") || true
# With the bundled upscaler, an installed Upscayl app still contributes its own models
APP_MODELS=""
if [[ -n $MODELS && $UPSCAYL == "$(realpath -m "$BUNDLE_BIN/upscayl-bin")" && -z ${UPSCAYL_MODELS:-} ]]; then
    app=$(find_upscayl installed) && APP_MODELS=$(find_models "$app") || true
    [[ $APP_MODELS != "$MODELS" ]] || APP_MODELS=""
fi

# --- Upscayl's own settings ---------------------------------------------------------------
# The Upscayl app keeps its settings in Chromium localStorage, a LevelDB database whose
# table files are snappy-compressed. This prints one line per requested key (empty if unset),
# taking the newest record across the write-ahead log and table files.
upscayl_settings() {
    local d
    have python3 || { printf '\n%.0s' "$@"; return; }
    for d in "${XDG_CONFIG_HOME:-$HOME/.config}/Upscayl" "$HOME/.var/app/org.upscayl.Upscayl/config/Upscayl" \
        "$HOME/snap/upscayl/current/.config/Upscayl"; do
        [[ -d "$d/Local Storage/leveldb" ]] || continue
        python3 - "$d/Local Storage/leveldb" "$@" <<'PY' && return
import glob, json, os, sys

def varint(b, i):
    r = s = 0
    while True:
        c = b[i]; i += 1
        r |= (c & 0x7f) << s; s += 7
        if c < 0x80:
            return r, i

def unsnappy(b):
    _, i = varint(b, 0)
    o = bytearray()
    while i < len(b):
        t = b[i]; i += 1
        if t & 3 == 0:
            n = t >> 2
            if n >= 60:
                w = n - 59; n = int.from_bytes(b[i:i + w], "little"); i += w
            o += b[i:i + n + 1]; i += n + 1
            continue
        if t & 3 == 1:
            n = ((t >> 2) & 7) + 4; off = (t >> 5) << 8 | b[i]; i += 1
        elif t & 3 == 2:
            n = (t >> 2) + 1; off = int.from_bytes(b[i:i + 2], "little"); i += 2
        else:
            n = (t >> 2) + 1; off = int.from_bytes(b[i:i + 4], "little"); i += 4
        for _ in range(n):
            o.append(o[-off])
    return bytes(o)

def block(f, off, size):
    f.seek(off); d = f.read(size + 1)
    return unsnappy(d[:size]) if d[size] == 1 else d[:size]

def entries(b):
    end = len(b) - 4 - 4 * int.from_bytes(b[-4:], "little")
    i, key = 0, b""
    while i < end:
        shared, i = varint(b, i); fresh, i = varint(b, i); vlen, i = varint(b, i)
        key = key[:shared] + b[i:i + fresh]; i += fresh
        yield key, b[i:i + vlen]; i += vlen

def table(path):  # yields (key, sequence, is_value, value)
    with open(path, "rb") as f:
        f.seek(-48, 2); foot = f.read(48)
        _, i = varint(foot, 0); _, i = varint(foot, i)
        ioff, i = varint(foot, i); isize, i = varint(foot, i)
        for _, h in entries(block(f, ioff, isize)):
            boff, j = varint(h, 0); bsize, j = varint(h, j)
            for k, v in entries(block(f, boff, bsize)):
                tag = int.from_bytes(k[-8:], "little")
                yield k[:-8], tag >> 8, tag & 0xff == 1, v

def log(path):
    data = open(path, "rb").read()
    pos, rec = 0, b""
    while pos + 7 <= len(data):
        left = 32768 - pos % 32768
        if left < 7:
            pos += left; continue
        n = data[pos + 4] | data[pos + 5] << 8; kind = data[pos + 6]
        frag = data[pos + 7:pos + 7 + n]; pos += 7 + n
        if kind in (1, 2):
            rec = frag
        elif kind in (3, 4):
            rec += frag
        else:
            break
        if kind not in (1, 4):
            continue
        seq = int.from_bytes(rec[:8], "little"); i = 12
        for c in range(int.from_bytes(rec[8:12], "little")):
            live = rec[i] == 1; i += 1
            kl, i = varint(rec, i); k = rec[i:i + kl]; i += kl
            v = b""
            if live:
                vl, i = varint(rec, i); v = rec[i:i + vl]; i += vl
            yield k, seq + c, live, v

d, names = sys.argv[1], sys.argv[2:]
# localStorage keys are "_<origin>\0\1<name>"; values start with \1 (Latin-1) or \0 (UTF-16)
suffix = {b"\0\1" + n.encode("latin-1"): n for n in names}
best = {}
files = [(table, p) for e in ("ldb", "sst") for p in glob.glob(os.path.join(d, "*." + e))]
files += [(log, p) for p in glob.glob(os.path.join(d, "*.log"))]
for reader, path in files:
    try:
        for k, seq, live, v in reader(path):
            for s, n in suffix.items():
                if k.startswith(b"_") and k.endswith(s) and seq > best.get(n, (-1,))[0]:
                    best[n] = (seq, v if live else b"")
    except Exception:
        pass
for n in names:
    v, out = best.get(n, (0, b""))[1], ""
    if v:
        s = v[1:].decode("utf-16-le" if v[0] == 0 else "latin-1", "replace")
        try:
            s = json.loads(s)
        except ValueError:
            pass
        if isinstance(s, (str, int)):
            out = str(s).replace("\n", " ")
    print(out)
PY
    done
    printf '\n%.0s' "$@"
}
mapfile -t settings < <(upscayl_settings customModelsPath gpuId)
upscayl_custom=${settings[0]:-} upscayl_gpu=${settings[1]:-}
CUSTOM_MODELS=${UPSCAYL_CUSTOM_MODELS:-$upscayl_custom}

# Every usable model (built-in first) and the folder it lives in
declare -A MODEL_DIR=([$NEAREST]=-)
MODEL_LIST=()
add_models() {
    local p n
    for p in "$1"/*.param; do
        n=${p##*/}; n=${n%.param}
        [[ -f $1/$n.bin && -z ${MODEL_DIR[$n]:-} ]] || continue
        MODEL_DIR[$n]=$1; MODEL_LIST+=("$n")
    done
}
[[ -n $MODELS ]] && add_models "$MODELS"
[[ -n $APP_MODELS ]] && add_models "$APP_MODELS"
[[ -n $CUSTOM_MODELS && -d $CUSTOM_MODELS ]] && add_models "$CUSTOM_MODELS"
is_custom() { [[ -n $CUSTOM_MODELS && ${MODEL_DIR[$1]:-} == "$CUSTOM_MODELS" && -z ${DESC[$1]:-} ]]; }
# Same rule as Upscayl: names with x2/2x or x3/3x are 2x/3x models, everything else 4x
model_scale() {
    case ${1,,} in *x2* | *2x*) echo 2 ;; *x3* | *3x*) echo 3 ;; *) echo 4 ;; esac
}

# GPUs as upscayl-bin numbers them ("id name" per line): it lists them before failing
# on the missing input. Loaded once into GPU_LIST.
gpus() {
    local m=${MODEL_LIST[0]:-}
    [[ -n $m ]] || return 0
    timeout 30 "$UPSCAYL" -i /nonexistent/upscale-gif-probe.png -o /dev/null -m "${MODEL_DIR[$m]}" -n "$m" 2>&1 \
        | sed -n 's/^\[\([0-9][0-9]*\) \(.*\)\]  queueC=.*/\1 \2/p' || true
}
GPU_LIST=() gpus_loaded=""
load_gpus() { [[ -n $gpus_loaded ]] || { mapfile -t GPU_LIST < <(gpus); gpus_loaded=1; }; }
# Software Vulkan drivers run on the CPU: they work, but extremely slowly
software_gpu() { [[ ${1,,} =~ llvmpipe|lavapipe|swiftshader ]]; }
NO_GPU_HELP="No GPU with a Vulkan driver was found, and the AI models need one.
Install the Vulkan driver for your graphics card: for AMD and Intel it is part of Mesa
(mesa-vulkan-drivers on Debian, Ubuntu and Fedora; vulkan-radeon or vulkan-intel on Arch),
and for NVIDIA it comes with NVIDIA's own driver. Virtual machines and remote desktop
sessions usually have no Vulkan GPU. 'vulkaninfo --summary' shows what Vulkan can see."
# Why the bundled upscaler can't run (missing libraries, too old a system), or nothing
bundle_error() {
    local b=$BUNDLE_BIN/upscayl-bin out
    [[ -z $UPSCAYL && -z ${UPSCAYL_BIN:-} && -e $b ]] || return 0
    out=$(timeout 10 "$b" -h 2>&1 | grep -v '^$' | head -1) || true
    echo "the bundled upscaler can't start: ${out:-unknown error}
It needs the Vulkan loader and libgomp (sudo apt install libvulkan1 libgomp1, sudo dnf install
vulkan-loader libgomp, or sudo pacman -S vulkan-icd-loader gcc-libs), and glibc 2.35 or
newer (Ubuntu 22.04, Debian 12, Fedora 36 or newer)."
}

encoder() { ffmpeg -hide_banner -encoders 2>/dev/null | awk '{ print $2 }' | grep -qx "$1"; }
declare -A ENCODER=([gif]=gif [mp4]=libx264 [webm]=libvpx-vp9 [avif]=libaom-av1 [png]=png [jpg]=mjpeg [webp]=libwebp)

check() {
    local ok=0 f m src line builtin=() app=() custom=()
    for m in "${MODEL_LIST[@]}"; do
        f=$m; (( $(model_scale "$m") == 4 )) || f+=" ($(model_scale "$m")×)"
        case ${MODEL_DIR[$m]} in
            "$MODELS") builtin+=("$f") ;; "$APP_MODELS") app+=("$f") ;; *) custom+=("$f") ;;
        esac
    done
    if [[ -n $UPSCAYL && $UPSCAYL == "$(realpath -m "$BUNDLE_BIN/upscayl-bin")" ]]; then
        echo "Upscayl binary: $UPSCAYL (bundled)"
    elif [[ -n $(bundle_error) ]]; then
        echo "Upscayl binary: NOT WORKING, $(bundle_error)" | sed '2,$s/^/                /'; ok=1
    else
        echo "Upscayl binary: ${UPSCAYL:-NOT FOUND (install Upscayl or set UPSCAYL_BIN)}"; [[ -n $UPSCAYL ]] || ok=1
    fi
    echo "Models folder:  ${MODELS:-NOT FOUND (set UPSCAYL_MODELS)}"; [[ -n $MODELS ]] || ok=1
    [[ -n $MODELS ]] && echo "Models:         ${builtin[*]}"
    echo "                (also $NEAREST: nearest neighbour for pixel art, no AI or GPU needed)"
    [[ -z $APP_MODELS ]] || { echo "Upscayl app:    $APP_MODELS"; echo "                ${app[*]}"; }
    src="Upscayl settings"; [[ -n ${UPSCAYL_CUSTOM_MODELS:-} ]] && src=UPSCAYL_CUSTOM_MODELS
    if [[ -z $CUSTOM_MODELS ]]; then
        echo "Custom models:  none (choose a folder in Upscayl's settings, or set UPSCAYL_CUSTOM_MODELS)"
        have python3 || echo "                (python3 is missing, so Upscayl's settings can't be read)"
    elif [[ ! -d $CUSTOM_MODELS ]]; then
        echo "Custom models:  $CUSTOM_MODELS (from $src) is missing"
    else
        echo "Custom models:  $CUSTOM_MODELS (from $src)"
        echo "                ${custom[*]:-no usable .param/.bin pairs}"
    fi
    if [[ -n $UPSCAYL && -n $MODELS ]]; then
        load_gpus
        echo "GPUs:"
        if (( ${#GPU_LIST[@]} == 0 )); then
            echo "  NONE FOUND"; sed 's/^/  /' <<<"$NO_GPU_HELP"; ok=1
        else
            for line in "${GPU_LIST[@]}"; do
                echo "  $line"; ! software_gpu "$line" || echo "    (software renderer on the CPU: works, but very slowly)"
            done
            echo "  default: ${upscayl_gpu:-auto}${upscayl_gpu:+ (from Upscayl settings)}"
        fi
    fi
    for f in ffmpeg ffprobe numfmt awk; do have $f || { echo "Missing:        $f"; ok=1; }; done
    if have ffmpeg; then
        echo "ffmpeg:         $(command -v ffmpeg) ($(ffmpeg -version | head -1 | cut -d' ' -f3))"
        for f in gif webp mp4 webm avif png jpg; do
            [[ $f != webp ]] || ENCODER[webp]=libwebp_anim
            if encoder "${ENCODER[$f]}"; then printf '  %-14s yes (%s)\n' "$f output:" "${ENCODER[$f]}"
            else printf '  %-14s no (ffmpeg lacks %s)\n' "$f output:" "${ENCODER[$f]}"; ok=1; fi
        done
    fi
    echo "Settings window: $(have zenity && echo zenity || echo 'unavailable (install zenity; command-line options still work)')"
    echo "File picker:     $(have kdialog && echo kdialog || { have zenity && echo zenity || echo unavailable; })"
    if (( $(ram_room) > 0 )); then
        echo "Temporary files: $WORKROOT, or with -t ram (or the settings window) in RAM ($RAMROOT)"
        echo "                 when under $(human "$(ram_room)") (half the available memory now)"
    else
        echo "Temporary files: $WORKROOT ($RAMROOT isn't a usable RAM disk)"
    fi
    return $ok
}

pick_file() {
    local filter="*.gif *.webp *.png *.apng *.avif *.mp4 *.m4v *.webm *.mkv *.mov *.jpg *.jpeg *.bmp *.tif *.tiff"
    if have kdialog; then
        kdialog --title "Choose an image, animation or video to upscale" --getopenfilename "$last_dir" "$filter|Images, animations and videos"
    else
        zenity --file-selection --title="Choose an image, animation or video to upscale" --filename="$last_dir/" \
            --file-filter="Images, animations and videos | $filter" --file-filter="All files | *"
    fi
}
even() { echo $(( ($1 + 1) / 2 * 2 )); }
human() { numfmt --to=iec --suffix=B "$1"; }
# Temporary space: PNG frames compress to roughly half of raw RGBA; original + upscaled copies
space_for() { echo $(( count * src_w * src_h * 4 * (1 + $1 * $1) / 2 )); }
# grid(e, n, out, lo, hi): the strongest grid of lo/100 to hi/100 px in the edge profile
# e[1..n-1] (e[i]: the colour change between pixels i-1 and i): out["p"] its size, out["s"]
# its strength (0-1) and out["f"] the position of a grid line
FOURIER_AWK='
    function grid(e, n, out, lo, hi,    p, P, i, a, re, im, tot, best, bp, k, c, v, fine, fp, fph, s) {
        tot = 0; for (i = 1; i < n; i++) tot += e[i]; if (!tot) return 0
        for (p = lo; p <= hi; p++) { P = p / 100; re = im = 0
            for (i = 1; i < n; i++) { a = 6.283185307 * i / P; re += e[i] * cos(a); im += e[i] * sin(a) }
            s[p] = sqrt(re * re + im * im) / tot; if (s[p] > best) { best = s[p]; bp = p } }
        # A grid of size P also shows at P/2, P/3: prefer a multiple that is nearly as strong
        for (k = 2; k * bp <= hi; k++) if (s[k * bp] >= 0.9 * best) { bp = k * bp; best = s[bp] }
        # Refine to 0.001 px (0.01 adds up to a pixel across the picture), measuring the
        # offset from the middle, where an error in the size matters least
        c = int(n / 2)
        for (p = bp * 10 - 10; p <= bp * 10 + 10; p++) { P = p / 1000; re = im = 0
            for (i = 1; i < n; i++) { a = 6.283185307 * (i - c) / P; re += e[i] * cos(a); im += e[i] * sin(a) }
            v = sqrt(re * re + im * im) / tot; if (v > fine) { fine = v; fp = P; fph = atan2(im, re) / 6.283185307 * P + c } }
        out["p"] = fp; out["s"] = fine; out["f"] = fph - int(fph / fp) * fp; if (out["f"] < 0) out["f"] += fp
        return 1
    }'
# pixel_grid: if the input is pixel art that was already enlarged by 2.2x or more, possibly
# by an uneven factor such as 3.5x (which makes pixels alternate between 3 and 4 wide and
# blurs their edges), prints "size_x size_y offset_x offset_y" of that pixel grid, else nothing.
# The colour change between neighbouring columns and rows peaks on the grid lines, so the
# grid is the strongest repeating pattern in those changes (a Fourier scan in awk). Looks at
# up to 6 frames and the middle 480x480 pixels.
pixel_grid() {
    local cw=$(( src_w < 480 ? src_w : 480 )) ch=$(( src_h < 480 ? src_h : 480 )) cx cy
    cx=$(( (src_w - cw) / 2 )) cy=$(( (src_h - ch) / 2 ))
