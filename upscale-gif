fi
if (( still )); then
    formats=("${IMAGE_FORMATS[@]}")
    in_ext=${input##*.}; in_ext=${in_ext,,}; [[ $in_ext != jpeg ]] || in_ext=jpg
    [[ " ${IMAGE_FORMATS[*]} " == *" $in_ext "* ]] || in_ext=""
    default_format=${last_image_format:-${in_ext:-png}}
    about="${src_w} × ${src_h}, still image"
else
    formats=("${ANIM_FORMATS[@]}")
    default_format=$last_format
