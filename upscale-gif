    done

    # Only offer a GPU choice when there is one to make; the default comes first
    gpu_items=()
    if [[ -z $gpu && -z $upscaler_error ]]; then
        gpu_list=("${GPU_LIST[@]}")
        if (( ${#gpu_list[@]} > 1 )); then
            for g in "${upscayl_gpu:-auto}" auto "${gpu_list[@]%% *}"; do
                case $g in
                    auto) item="auto — Let Upscayl choose" ;;
                    *) item=$(printf '%s\n' "${gpu_list[@]}" | awk -v g="$g" '$1 == g { $1 = ""; print g " —" $0; exit }')
                       [[ -n $item ]] || item="$g — Upscayl setting" ;;
                esac
