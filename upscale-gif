# the frames. Without them only nearest-neighbour scaling is possible.
upscaler_error=""
if [[ $model != "$NEAREST" ]]; then
    upscaler_error=$(bundle_error)
    [[ -n $upscaler_error || -n $UPSCAYL ]] \
        || upscaler_error="Upscayl not found. Install it, or set UPSCAYL_BIN to the path of upscayl-bin (run with -c for details)."
    [[ -n $upscaler_error || -n $MODELS ]] || upscaler_error="found $UPSCAYL but no models folder next to it; set UPSCAYL_MODELS"
    if [[ -z $upscaler_error ]]; then load_gpus; (( ${#GPU_LIST[@]} )) || upscaler_error=$NO_GPU_HELP; fi
fi
if [[ -n $upscaler_error ]]; then
    [[ -z $model ]] || die "$upscaler_error
(-m $NEAREST, nearest neighbour for pixel art, works without it.)"
    # The settings window then offers only nearest neighbour, and says why
    MODEL_DIR=([$NEAREST]=-) MODEL_LIST=()
fi
for g in ${gpu//,/ }; do
    (( ${#GPU_LIST[@]} )) || break
    [[ $g == auto ]] || printf '%s\n' "${GPU_LIST[@]%% *}" | grep -qx "$g" \
        || die "there is no GPU $g. Available: $(printf '%s; ' "${GPU_LIST[@]}" | sed 's/; $//')"
done
gpu_warn=""
for line in "${GPU_LIST[@]}"; do software_gpu "$line" || { gpu_warn=x; break; }; done
[[ -n $gpu_warn || ${#GPU_LIST[@]} == 0 ]] && gpu_warn="" \
    || gpu_warn="Only a software Vulkan driver was found (${GPU_LIST[0]#* }): upscaling runs on the CPU and is very slow. Install your graphics card's Vulkan driver to use the GPU."
[[ -z $quality ]] || { [[ $quality =~ ^[0-9]+$ ]] && (( quality >= 1 && quality <= 100 )); } || die "quality must be 1 to 100"
[[ -z $downsampler || " ${DOWNSAMPLERS[*]} " == *" $downsampler "* ]] || die "downsampler must be one of: ${DOWNSAMPLERS[*]}"
[[ $temp =~ ^(auto|ram|disk)$ ]] || die "-t must be auto, ram or disk"

# Remembered choices from the last run
last_model="" last_format=gif last_image_format="" last_quality=80 last_downsampler=lanczos last_dir=$HOME
[[ -f $CONF ]] && source "$CONF"
if [[ -z $last_model || -z ${MODEL_DIR[$last_model]:-} ]]; then
    last_model=${MODEL_LIST[0]:-}
    for m in "${MODEL_ORDER[@]}"; do [[ -z ${MODEL_DIR[$m]:-} ]] || { last_model=$m; break; }; done
fi

# --- Choose file -------------------------------------------------------------------
if [[ -z $input ]]; then
    gui || die "no input file given (and no desktop session for a file picker)"
    [[ -d $last_dir ]] || last_dir=$HOME
    input=$(pick_file) || exit 0
fi
[[ -f $input ]] || die "file not found: $input"
# Absolute path, so a name starting with "-" isn't taken for an option
input=$(realpath -- "$input")

# --- Probe -------------------------------------------------------------------------
# Use the video stream with the most frames: AVIF files also carry a still image (and
# alpha) as separate streams, and the animation is the longer one.
vidx="" aidx="" best=-1
while IFS='|' read -r idx frames; do
    [[ $frames =~ ^[0-9]+$ ]] || frames=0
    if (( frames > best )); then best=$frames vidx=$idx; fi
done < <(ffprobe -v error -select_streams v -show_entries stream=index,nb_frames -of csv=p=0:s='|' "$input")
[[ -n $vidx ]] || die "no video found in $(basename "$input")"

# Animated AVIF keeps transparency in a second track with the same frame count
brand=$(ffprobe -v error -show_entries format_tags=major_brand -of csv=p=0 "$input")
if [[ $brand == avi[fs] ]] && (( best > 0 )); then
    aidx=$(ffprobe -v error -select_streams v -show_entries stream=index,nb_frames -of csv=p=0:s='|' "$input" \
        | awk -F'|' -v v="$vidx" -v n="$best" '$1 > v && $2 == n { print $1; exit }')
fi

src_w=0 src_h=0 avg_rate="" sar="" rotation=0
while IFS='=' read -r key value; do
    case $key in
        width) src_w=$value ;; height) src_h=$value ;; avg_frame_rate) avg_rate=$value ;;
        sample_aspect_ratio) sar=$value ;; rotation) rotation=${value%.*} ;;
    esac
done < <(ffprobe -v error -select_streams "$vidx" -of default=nw=1 \
    -show_entries stream=width,height,avg_frame_rate,sample_aspect_ratio:stream_side_data=rotation "$input")
(( src_w > 0 && src_h > 0 )) || die "can't read the picture size of $(basename "$input")"
# Work with the size as displayed: non-square pixels (anamorphic video; viewers ignore the
# GIF header's aspect field) and phone videos stored sideways with a rotation flag, which
# ffmpeg turns upright when decoding.
sar_fixed=0
if [[ $sar =~ ^([0-9]+):([0-9]+)$ ]] && (( BASH_REMATCH[1] > 0 && BASH_REMATCH[2] > 0 )) \
    && [[ $(ffprobe -v error -show_entries format=format_name -of csv=p=0 "$input") != gif ]]; then
    src_w=$(( (src_w * BASH_REMATCH[1] + BASH_REMATCH[2] / 2) / BASH_REMATCH[2] ))
    (( BASH_REMATCH[1] == BASH_REMATCH[2] )) || sar_fixed=1
fi
# Photos keep their orientation (EXIF) on the frame instead of the stream
if (( rotation == 0 )); then
    rotation=$(ffprobe -v error -select_streams "$vidx" -read_intervals '%+#1' \
        -show_entries frame_side_data=rotation -of default=nw=1:nk=1 "$input" | head -1)
    rotation=${rotation%.*}; [[ $rotation =~ ^-?[0-9]+$ ]] || rotation=0
fi
if (( rotation % 180 != 0 )); then t=$src_w; src_w=$src_h; src_h=$t; fi
fallback=$(awk -v r="$avg_rate" 'BEGIN { split(r, a, "/"); f = (a[2] ? a[1] / a[2] : 0); printf "%.6f", (f > 0 ? 1 / f : 0.1) }')

# Per-frame durations: gap to the next frame's timestamp, else the frame's own
# duration, else the average frame time. Zero GIF delays play at 0.1 s in browsers.
mapfile -t durations < <(ffprobe -v error -select_streams "$vidx" \
    -show_entries frame=best_effort_timestamp_time,duration_time -of compact=p=0 "$input" |
    awk -F'|' -v fb="$fallback" '
        { t = d = ""
          for (i = 1; i <= NF; i++) { split($i, kv, "=")
              if (kv[1] == "best_effort_timestamp_time") t = kv[2]
              if (kv[1] == "duration_time") d = kv[2] }
          ts[NR] = t; du[NR] = d }
        END { for (i = 1; i <= NR; i++) {
                  g = (i < NR && ts[i] != "N/A" && ts[i+1] != "N/A") ? ts[i+1] - ts[i] : 0
                  if (g <= 0) g = (du[i] != "N/A" && du[i] + 0 > 0) ? du[i] : fb
                  if (g <= 0) g = 0.1
                  printf "%.6f\n", g } }')
count=${#durations[@]}
(( count > 0 )) || die "no frames found in $(basename "$input")"
total=$(printf '%s\n' "${durations[@]}" | awk '{ s += $1 } END { printf "%.1f", s }')
fps=$(awk -v n="$count" -v t="$total" 'BEGIN { printf "%.1f", (t > 0 ? n / t : 0) }')
max_h=$((src_h * 4))

# Until the model is chosen, assume a 4× model (the largest)
need=$(space_for 4)
mkdir -p "$WORKROOT" || die "can't create $WORKROOT"
free=$(( $(df --output=avail -B1 "$WORKROOT" | tail -1) ))
choose_temp

# A single frame is a still image: it can also be saved as png or jpg
still=0; (( count == 1 )) && still=1
if (( ! still )); then
    ENCODER[webp]=libwebp_anim
    FMT_DESC[webp]="Animated WebP (full colour, keeps transparency, smaller than GIF)"
fi
if (( still )); then
    formats=("${IMAGE_FORMATS[@]}")
    in_ext=${input##*.}; in_ext=${in_ext,,}; [[ $in_ext != jpeg ]] || in_ext=jpg
    [[ " ${IMAGE_FORMATS[*]} " == *" $in_ext "* ]] || in_ext=""
    default_format=${last_image_format:-${in_ext:-png}}
    about="${src_w} × ${src_h}, still image"
else
    formats=("${ANIM_FORMATS[@]}")
    default_format=$last_format
    about="${src_w} × ${src_h}, $count frames, ${total}s, ~$fps fps"
fi
[[ " ${formats[*]} " == *" $default_format "* ]] || default_format=${formats[0]}

# --- Settings window (only for what wasn't given on the command line) ----------------
if [[ -z $model || -z $format || ( -z $width && -z $height ) ]]; then
    gui || die "missing -m/-f/-w options (and no desktop session for the settings window)"

    model_items=()
    for m in "$last_model" "${MODEL_ORDER[@]}" "$NEAREST" "${MODEL_LIST[@]}"; do
        [[ -n $m && -n ${MODEL_DIR[$m]:-} ]] || continue
        if [[ $m == "$NEAREST" ]]; then
            item="$m — $NEAREST_DESC"
        elif [[ -n ${DESC[$m]:-} ]]; then
            item="$m — ${DESC[$m]}"
        else
            item=$m; is_custom "$m" && item+=" — Custom model"
            (( $(model_scale "$m") == 4 )) || item+="${item/*—*/,}${item/*—*/ —} $(model_scale "$m")×"
        fi
        [[ " ${model_items[*]} " == *" $item "* ]] || model_items+=("$item")
    done

    size_items=()
    for f in 4 3 2; do
        size_items+=("$(even $((src_w * f))) × $(even $((src_h * f)))  (${f}×)")
    done
    for target in 720 1080 1440 2160; do
        (( target > src_h && target < max_h )) || continue
        size_items+=("$(even $((src_w * target / src_h))) × $target  (fits ${target}p)")
    done

    format_items=()
    for f in "$default_format" "${formats[@]}"; do
        encoder "${ENCODER[$f]}" || continue
        [[ " ${format_items[*]} " == *" $f — "* ]] || format_items+=("$f — ${FMT_DESC[$f]}")
    done

    # Only offer a GPU choice when there is one to make; the default comes first
    gpu_items=()
    if [[ -z $gpu && -z $upscaler_error ]]; then
        gpu_list=("${GPU_LIST[@]}")
        if (( ${#gpu_list[@]} > 1 )); then
            for g in "${upscayl_gpu:-auto}" auto "${gpu_list[@]%% *}"; do
                case $g in
                    auto) item="auto — Let Upscayl choose" ;;
                    *) item=$(printf '%s\n' "${gpu_list[@]}" | awk -v g="$g" '$1 == g { $1 = ""; print g " —" $0; exit }')
                       [[ -n $item ]] || item="$g — Upscayl setting" ;;
                esac
                [[ " ${gpu_items[*]} " == *" $g — "* ]] || gpu_items+=("$item")
            done
        fi
    fi

    warn=""
    (( count > 500 )) && warn="\n⚠ $count frames: this will take a while. Long videos are better served by a video upscaler such as Video2X."
    [[ -z $gpu_warn ]] || warn+="\n⚠ $gpu_warn"
    if [[ -n $upscaler_error ]]; then
        e=${upscaler_error//&/&amp;}; e=${e//</&lt;}; e=${e//>/&gt;}
        warn+="\n⚠ Only nearest-neighbour scaling is available: <small>$e</small>"
    fi
    [[ $temp_where == RAM ]] || (( need <= free )) || warn+="\n⚠ Not enough free space in $WORKROOT."

    # zenity forms have no tooltips, so the custom-width help is shown in the window text
    custom_help="<small><b>Custom width:</b> type a width in pixels, e.g. <tt>$(even $((src_w * 3)))</tt>, to use instead of <i>Output size</i>.
Height follows the original aspect ratio, and both are rounded to even numbers.
Up to <b>$((src_w * 4))</b> px (4× the original) stays sharp with 4× models; beyond a model's scale it's stretched.
<i>$NEAREST</i> uses whole multiples (2×, 3×…) of the original, rounding down, with no upper limit.
Leave empty to use <i>Output size</i>.</small>"

    join() { local IFS='|'; echo "$*"; }
    # Only ask for what the command line didn't settle
    fields=() keys=()
    field() { keys+=("$1"); shift; fields+=("$@"); }
    [[ -n $model ]] || field model --add-combo="Model" --combo-values="$(join "${model_items[@]}")"
    if [[ -z $width && -z $height ]]; then
        field size --add-combo="Output size" --combo-values="$(join "${size_items[@]}")"
        field custom --add-entry="Custom width in pixels (optional)"
    else
        custom_help=""
    fi
    [[ -n $format ]] || field format --add-combo="Format" --combo-values="$(join "${format_items[@]}")"
    if [[ -z $quality && $format != png ]]; then
        quality_items=()
        for q in "$last_quality" "${QUALITIES[@]}"; do
            [[ " ${quality_items[*]} " == *" $q% "* ]] || quality_items+=("$q%")
        done
        quality_label="Quality (higher is better but larger)"; (( still )) && quality_label+=", not used for PNG"
        field quality --add-combo="$quality_label" --combo-values="$(join "${quality_items[@]}")"
    fi
    if [[ -z $downsampler && $model != "$NEAREST" ]]; then
        downsampler_items=()
        for d in "$last_downsampler" "${DOWNSAMPLERS[@]}"; do
            [[ -n ${DOWNSAMPLER_DESC[$d]:-} && " ${downsampler_items[*]} " != *" $d — "* ]] || continue
            downsampler_items+=("$d — ${DOWNSAMPLER_DESC[$d]}")
        done
        field downsampler --add-combo="Downsampler (for AI models)" \
            --combo-values="$(join "${downsampler_items[@]}")"
    fi
    (( ${#gpu_items[@]} )) && field gpu --add-combo="GPU" --combo-values="$(join "${gpu_items[@]}")"
    form=$(zenity --forms --title="Upscale GIF" --width=480 --separator=$'\x1f' \
        --text="<b>$(basename "$input")</b>\n$about\n$space_note$warn${custom_help:+\n\n$custom_help}" \
        "${fields[@]}") || exit 0
    IFS=$'\x1f' read -r -a answers <<<"$form"
    declare -A answer=()
    for i in "${!keys[@]}"; do answer[${keys[$i]}]=${answers[$i]:-}; done
    f_model=${answer[model]:-} f_size=${answer[size]:-} f_custom=${answer[custom]:-} f_format=${answer[format]:-} f_gpu=${answer[gpu]:-}
    if [[ -n ${answer[downsampler]+set} ]]; then
        downsampler=${answer[downsampler]%% —*}; [[ -n $downsampler ]] || downsampler=${downsampler_items[0]%% —*}
    fi
    if [[ -n ${answer[quality]+set} ]]; then
        quality=${answer[quality]%\%}; [[ -n $quality ]] || quality=$last_quality
    fi

    [[ -n $model ]] || model=${f_model%% —*}
    [[ -n $model ]] || model=${model_items[0]%% —*}
    [[ -n $format ]] || format=${f_format%% —*}
    if (( ${#gpu_items[@]} )); then
        [[ -n $f_gpu ]] || f_gpu=${gpu_items[0]}
        gpu=${f_gpu%% —*}
    fi
    if [[ -z $width && -z $height ]]; then
        if [[ -n ${f_custom// /} ]]; then
            width=${f_custom// /}
        else
            [[ -n $f_size ]] || f_size=${size_items[0]}
            width=${f_size%% ×*}
        fi
    fi
fi

# --- Validate and work out the final size --------------------------------------------
format=${format:-$default_format} quality=${quality:-80} downsampler=${downsampler:-lanczos}
[[ $quality =~ ^[0-9]+$ ]] && (( quality >= 1 && quality <= 100 )) || quality=80
[[ -n $model && -n ${MODEL_DIR[$model]:-} ]] || die "unknown model '$model'. Available: ${MODEL_LIST[*]} $NEAREST"
nearest=0; [[ $model != "$NEAREST" ]] || nearest=1
gpu=${gpu:-${upscayl_gpu:-auto}}
if (( nearest )); then
    scale=1 max_w=0 need=$(space_for 0) gpu_warn=""
else
    scale=$(model_scale "$model")
    max_w=$((src_w * scale)) need=$(space_for "$scale")
fi
choose_temp
[[ $format =~ ^(gif|mp4|webm|avif|png|jpg|webp)$ ]] || die "unsupported format: $format"
[[ $still == 1 || ! $format =~ ^(png|jpg)$ ]] \
    || die "$format output is for single images, and $(basename "$input") has $count frames (use gif, webp, webm, avif or mp4)"
encoder "${ENCODER[$format]}" || die "this ffmpeg build can't encode $format (missing ${ENCODER[$format]})"
if [[ -n $width ]]; then
    [[ $width =~ ^[0-9]+$ ]] && (( width > 0 )) || die "width must be a whole number"
    out_w=$(even "$width"); out_h=$(even $((width * src_h / src_w)))
else
    [[ $height =~ ^[0-9]+$ ]] && (( height > 0 )) || die "height must be a whole number"
    out_h=$(even "$height"); out_w=$(even $((height * src_w / src_h)))
fi
(( out_w >= 2 )) || out_w=2
(( out_h >= 2 )) || out_h=2
pad="" restore="" base_w=$src_w base_h=$src_h
if (( nearest && ! sar_fixed )); then
    # Pixel art that was already enlarged is first brought back to its own pixel grid: each
    # grid cell becomes one pixel, taken from the cell's middle, away from blurred edges.
    # Sampling at the grid's exact (often fractional) positions is done on a 2x copy.
    read -r gx gy fx fy < <(pixel_grid) || true
    if [[ -n ${gx:-} ]]; then
        read -r base_w base_h cw ch cx cy uneven < <(awk -v P="$gx" -v Q="$gy" -v fx="$fx" -v fy="$fy" -v w="$src_w" -v h="$src_h" 'BEGIN {
            c = int((w - fx) / P); r = int((h - fy) / Q); r0 = int(P + 0.5)
            printf "%d %d %d %d %d %d %d\n", c, r, int(2 * c * P + 0.5), int(2 * r * Q + 0.5), int(2 * fx + 0.5), int(2 * fy + 0.5), (P - r0 > 0.05 || r0 - P > 0.05) }')
        restore="scale=iw*2:ih*2:flags=neighbor,crop=$cw:$ch:$cx:$cy,scale=$base_w:$base_h:flags=neighbor,"
        note="Note: this looks like pixel art that was enlarged $(awk -v v="$gx" 'BEGIN { s = sprintf("%.2f", v); sub(/\.?0+$/, "", s); print s }')×; restoring its original ${base_w}×${base_h} pixels"
        if (( uneven )); then
            # An uneven enlargement blends neighbouring colours: merge them back into a palette
            restore+="split[pxa][pxb];[pxa]palettegen=max_colors=64:stats_mode=full[pxp];[pxb][pxp]paletteuse=dither=none:alpha_threshold=128,format=rgba,"
            note+=" and cleaning up blended colours"
        fi
        echo "$note."
    fi
fi
if (( nearest )); then
    # Whole multiples only, so every source pixel becomes the same size square. MP4 and WebM
    # need even sizes: an odd one gets a 1-pixel transparent (MP4: black) edge.
    if [[ -n $width ]]; then scale=$(( out_w / base_w )); else scale=$(( out_h / base_h )); fi
    (( scale >= 1 )) || scale=1
    req="${out_w}×${out_h}"
    out_w=$((base_w * scale)) out_h=$((base_h * scale))
    if [[ $format =~ ^(mp4|webm)$ ]] && (( out_w % 2 || out_h % 2 )); then
        pad=",pad=$(even $out_w):$(even $out_h):0:0:black@0"
        out_w=$(even $out_w) out_h=$(even $out_h)
    fi
    [[ $req == "${out_w}×${out_h}" ]] \
        || echo "Note: nearest neighbour uses whole multiples of ${base_w}×${base_h}: ${out_w}×${out_h} (${scale}×) instead of $req."
fi
if [[ $temp == ram && $temp_where != RAM ]]; then
    die "the temporary frames (~$(human "$need")) don't fit in RAM: $(human "$(ram_room forced)") can be used. Use -t disk or -t auto."
fi
[[ $temp_where == RAM ]] || (( need <= free )) || die "not enough space in $WORKROOT: $space_note"
(( nearest || out_w <= max_w )) || echo "Note: ${out_w}px is wider than the model's ${scale}× (${max_w}px); the last step will enlarge."

output=${output:-${input%.*}_${out_w}x${out_h}.$format}
[[ $(realpath -m "$output") != "$input" ]] || die "output would overwrite the input"
out_dir=$(dirname -- "$output")
[[ -d $out_dir ]] || die "folder not found: $out_dir"
[[ -w $out_dir ]] || die "can't write to $out_dir"

if (( still )); then last_image_format=$format; else last_format=$format; fi
[[ $format == png ]] || last_quality=$quality
(( nearest )) || last_downsampler=$downsampler
{ mkdir -p "$(dirname "$CONF")" && printf 'last_model=%q\nlast_format=%q\nlast_image_format=%q\nlast_quality=%q\nlast_downsampler=%q\nlast_dir=%q\n' \
    "$model" "$last_format" "$last_image_format" "$last_quality" "$last_downsampler" "$(dirname "$(realpath "$input")")" >"$CONF"; } 2>/dev/null || true

echo "Input:  ${about// × /×}"
q_note=", quality $quality%"; [[ $format != png ]] || q_note=""
if (( nearest )); then
    [[ $format != webp ]] || q_note=", lossless"
    echo "Output: ${out_w}×${out_h} $format$q_note, nearest neighbour (${scale}×)"
else
    echo "Output: ${out_w}×${out_h} $format$q_note, model $model (${scale}×), $downsampler downsampling, GPU $gpu"
fi
[[ -z $gpu_warn ]] || echo "Note: $gpu_warn"
if [[ $temp_where == RAM ]]; then echo "Temp:   ~$(human "$need") in RAM ($RAMROOT)"
else echo "Temp:   ~$(human "$need") on disk ($WORKROOT)"; fi

# Temporary frames go to RAM only when they fit comfortably (choose_temp), else to disk; not
# to /tmp, which may be a small tmpfs. Upscaled frames can take several GB.
# The slow steps run in the background so that closing the terminal or a kill stops them
# too (bash only runs traps between commands) and the work folder is always removed.
work="" child=""
cleanup() {
    # A second Ctrl+C mustn't interrupt the cleanup
    trap '' INT TERM HUP
    if [[ -n $child ]]; then kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi
    declare -F progress_close >/dev/null && progress_close
    [[ -z $work ]] || rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
work=$(mktemp -d "$temp_root/upscale-gif.XXXXXX")
mkdir "$work/frames" "$work/upscaled"
# Nearest neighbour scales the original frames while encoding
scaled=$work/upscaled; (( ! nearest )) || scaled=$work/frames

# --- Progress -----------------------------------------------------------------------------
# Upscayl only reports progress per image, so progress comes from counting finished frames.
# It is shown in a window with a Cancel button when there is no terminal (e.g. started from
# the desktop), and as a bar in the terminal otherwise. The slow steps run in the background
# while a loop updates it.
exec 3>&2
progress_mode=none progress_pid="" cancelled=$work/cancelled shown="" up_start=""
if [[ ! -t 1 ]] && gui; then progress_mode=window
elif [[ -t 2 ]]; then progress_mode=terminal; fi
if [[ $progress_mode == window ]]; then
    trap '' PIPE
    # zenity exits with 1 when Cancel is pressed or the window is closed
    exec 4> >(zenity --progress --title="Upscale GIF" --width=460 --auto-close --percentage=0 \
        --text="$(basename "$input")" 2>/dev/null || touch "$cancelled")
    progress_pid=$!
fi
progress_close() {
    [[ -n $progress_pid ]] || return 0
    exec 4>&-
    kill "$progress_pid" 2>/dev/null || true
    progress_pid=""
}
fmt_time() {
    if (( $1 >= 3600 )); then printf '%d:%02d:%02d' $(($1 / 3600)) $(($1 / 60 % 60)) $(($1 % 60))
    else printf '%d:%02d' $(($1 / 60)) $(($1 % 60)); fi
}
# Messages go above the terminal progress bar
say() { [[ $progress_mode != terminal ]] || printf '\r\033[K' >&3; echo "$@"; }
# progress PERCENT TEXT [eta]: "eta" estimates the time left from the upscaling speed
# (it starts at 3% and takes most of the time)
progress() {
    local p=$1 text=$2 left="" bar
    (( p < 100 )) || p=99
    if [[ ${3:-} == eta && -n $up_start ]] && (( p > 4 && SECONDS - up_start >= 3 )); then
        left="about $(fmt_time $(( (SECONDS - up_start) * (100 - p) / (p - 3) + 1 ))) left"
    fi
    [[ "$p $text $left" != "$shown" ]] || return 0
    shown="$p $text $left"
    case $progress_mode in
        window) printf '%d\n# %s%s\n' "$p" "$text" "${left:+ — $left}" >&4 2>/dev/null || true ;;
        terminal)
            printf -v bar '%*s' $((p * 30 / 100)) ''
            printf '\r\033[K[%-30s] %3d%%  %s%s' "${bar// /#}" "$p" "$text" "${left:+, $left}" >&3 ;;
    esac
}
progress_finish() {
    case $progress_mode in
        window) printf '100\n' >&4 2>/dev/null || true; sleep 0.3; progress_close ;;
        terminal) printf '\r\033[K' >&3 ;;
    esac
}
count_files() { local f=("$1"/*); [[ -e ${f[0]} ]] && echo ${#f[@]} || echo 0; }
count_extracted() { count_files "$work/frames"; }
count_upscaled() { count_files "$work/upscaled"; }
count_encoded() { local n; n=$(sed -n 's/^frame=//p' "$work/progress.txt" 2>/dev/null | tail -1); echo "${n:-0}"; }
# watch FROM TO TEXT COUNTER ETA LOG -- command...: runs the command (its output going to
# LOG unless that is "-") and maps the count from
# COUNTER (out of $count) onto FROM..TO percent; TEXT gets the count and total via printf.
# "eta" shows the time left; "eta-started" only once the count has started moving.
watch() {
    local from=$1 to=$2 text=$3 counter=$4 eta=$5 log=$6 n e rc=0
    shift 7
    if [[ $log == - ]]; then "$@" & else "$@" >"$log" 2>&1 & fi
    child=$!
    while kill -0 "$child" 2>/dev/null; do
        [[ ! -e $cancelled ]] || { say "Cancelled."; exit 130; }
        n=$("$counter"); (( n <= count )) || n=$count
        e=$eta; [[ $eta != eta-started ]] || { (( n > 0 )) && e=eta || e=-; }
        # shellcheck disable=SC2059
        progress $(( from + (to - from) * n / count )) "$(printf "$text" "$n" "$count")" "$e"
        sleep 0.5
    done
    wait "$child" || rc=$?
    child=""
    return $rc
}

# --- Extract (lossless PNG, every frame, transparency kept) ----------------------------
say "Extracting frames..."
if [[ -n $aidx ]]; then
    extract=(-filter_complex "[0:$vidx][0:$aidx]alphamerge,format=rgba")
else
    extract=(-map "0:$vidx" -pix_fmt rgba)
fi
watch 0 3 "Reading frame %d of %d" count_extracted - - -- \
    ffmpeg -nostdin -v error -i "$input" "${extract[@]}" -fps_mode passthrough "$work/frames/%06d.png" \
    || die "ffmpeg could not read the frames of $(basename "$input")$(ram_hint)"
extracted=$(count_extracted)
(( extracted > 0 )) || die "no frames could be decoded from $(basename "$input")"
if (( extracted != count )); then
    say "Note: decoded $extracted frames (probe saw $count); spacing them evenly over ${total}s."
    d=$(awk -v t="$total" -v n="$extracted" 'BEGIN { printf "%.6f", t / n }')
    durations=(); for ((i = 0; i < extracted; i++)); do durations+=("$d"); done
    count=$extracted
fi

# --- Upscale ------------------------------------------------------------------------------
if (( ! nearest )); then
    say "Upscaling $count frames with $model..."
    gpu_arg=(); [[ $gpu == auto ]] || gpu_arg=(-g "$gpu")
    # Saving the PNGs is the slow part with Upscayl's default of 2 saving threads; one per CPU
    # thread made upscaling 2-5x faster without using more memory. -j takes one GPU thread
    # count per GPU.
    procs=2; [[ $gpu == auto ]] || { procs=${gpu//[0-9]/}; procs=$(printf '2%.0s' $(seq 0 ${#procs}) | sed 's/./&,/g; s/,$//'); }
    savers=$(nproc 2>/dev/null || echo 4); (( savers >= 2 )) || savers=2; (( savers <= 16 )) || savers=16
    up_start=$SECONDS
    watch 3 85 "Upscaling frame %d of %d" count_upscaled eta "$work/upscayl.log" -- \
        "$UPSCAYL" -i "$work/frames" -o "$work/upscaled" -m "${MODEL_DIR[$model]}" -n "$model" \
        -z "$scale" -s "$scale" "${gpu_arg[@]}" -j "2:$procs:$savers" -f png \
        || { tail -20 "$work/upscayl.log" >&2; die "Upscayl failed$(ram_hint)"; }
    upscaled=$(count_upscaled)
    (( upscaled == count )) || { tail -20 "$work/upscayl.log" >&2; die "Upscayl produced $upscaled of $count frames$(ram_hint)"; }
fi

# --- Reassemble with each frame's original timing ---------------------------------------
# The concat demuxer takes its time base from the images (1/25 s by default), which would
# round every timestamp to 0.04 s; 1/90000 s is exact for all common frame rates. The last
# entry's duration is ignored (it lasts one tick), so GIF sets the final delay directly and
# the other formats end with a one-tick copy of the last frame.
list=$work/frames.txt
frame() {
    local p=$scaled/$(printf %06d "$1").png
    printf "file '%s'\noption framerate 90000\n" "${p//\'/\'\\\'\'}"
}
for i in "${!durations[@]}"; do
    frame $((i + 1)); printf "duration %s\n" "${durations[$i]}"
done >"$list"
[[ $format =~ ^(gif|webp)$ ]] || frame "$count" >>"$list"
final_delay=$(awk -v d="${durations[count - 1]}" 'BEGIN { printf "%d", d * 100 + 0.5 }')
total_ms=$(printf '%s\n' "${durations[@]}" | awk '{ s += $1 } END { printf "%d", s * 1000 + 0.5 }')

# ffmpeg doesn't pass the last frame's length to libwebp, which then uses the average frame
# length. The delay is a 24-bit millisecond field in each ANMF chunk, 20 bytes after the
# chunk's start, so the last one is set here directly: to the total length minus the frames
# before it, because libwebp merges identical frames and the last one may stand for several.
webp_last_delay() {   # webp_last_delay FILE TOTAL_MS
    local f=$1 ms=$2 size off=12 last="" h len d before=0 prev=0
    size=$(stat -c %s "$f")
    while (( off + 8 <= size )); do
        read -ra h < <(od -An -tu1 -j "$off" -N 8 "$f")
        len=$(( h[4] | h[5] << 8 | h[6] << 16 | h[7] << 24 ))
        if (( h[0] == 65 && h[1] == 78 && h[2] == 77 && h[3] == 70 )); then   # "ANMF"
            read -ra d < <(od -An -tu1 -j $((off + 20)) -N 3 "$f")
            before=$(( before + prev )) prev=$(( d[0] | d[1] << 8 | d[2] << 16 )) last=$off
        fi
        off=$(( off + 8 + len + (len & 1) ))
    done
    [[ -n $last ]] || return 0
    ms=$(( ms - before )); (( ms >= 1 )) || ms=1
    (( ms <= 16777215 )) || ms=16777215
    printf "$(printf '\\x%02x\\x%02x\\x%02x' $((ms & 255)) $((ms >> 8 & 255)) $((ms >> 16 & 255)))" \
        | dd of="$f" bs=1 seek=$((last + 20)) conv=notrunc status=none
}

say "Encoding $format..."
resize="scale=${out_w}:${out_h}:flags=$downsampler,setsar=1"
dither=sierra2_4a enc_from=85
if (( nearest )); then
    resize="${restore}scale=$((base_w * scale)):$((base_h * scale)):flags=neighbor,setsar=1$pad"
    # Pixel art keeps its colours: no dithering in GIFs, and lossless WebP (lossy WebP
    # smears colour across the hard edges). Encoding is all the work, so it gets the whole bar.
    dither=none enc_from=3 up_start=$SECONDS
fi
stats=(-stats); [[ $progress_mode == none ]] || stats=(-nostats)
in=(-nostdin -v error "${stats[@]}" -progress "$work/progress.txt" -stats_period 0.5 -y -f concat -safe 0 -i "$list")
# The frames start at 0; when the picture starts later than the audio, skip that much
# audio so they stay in sync
first=$(ffprobe -v error -select_streams "$vidx" -read_intervals '%+#1' \
    -show_entries frame=best_effort_timestamp_time -of default=nw=1:nk=1 "$input" | head -1)
start=$(ffprobe -v error -show_entries format=start_time -of default=nw=1:nk=1 "$input")
skip=$(awk -v a="$first" -v b="$start" 'BEGIN { d = a - b; if (a != "N/A" && b != "N/A" && d > 0.001) printf "%.6f", d }')
audio=(${skip:+-ss "$skip"} -i "$input" -map 0:v -map "1:a:0?")
# Quality (1-100) on each encoder's own scale; 80 gives the earlier defaults. 100 is
# lossless for WebP, 256 colours for GIF from 80 up.
qmap() { awk -v q="$quality" -v a="$1" -v b="$2" -v lo="$3" -v hi="$4" \
    'BEGIN { v = int(a - q * b + 0.5); if (v < lo) v = lo; if (v > hi) v = hi; print v }'; }
crf_x264=$(qmap 51 0.4375 0 51)    # 80 -> 16
crf_vp9=$(qmap 63 0.5625 0 63)     # 80 -> 18
crf_aom=$(qmap 63 0.5375 0 63)     # 80 -> 20
q_jpeg=$(qmap 31 0.3 1 31)         # 80 -> 7 (ffmpeg's 1-31 scale, lower is better)
gif_colors=$(qmap 0 -3.2 2 256)    # 80 and up -> 256
webp_opts=(-quality "$quality"); (( quality < 100 && ! nearest )) || webp_opts=(-lossless 1 -quality 100)
single=(); (( ! still )) || single=(-frames:v 1)   # a still AVIF, not a one-frame animation
# GIF output only appears at the end (the palette needs every frame first)
encode() {
    watch "$enc_from" 100 "Encoding $format, frame %d of %d" count_encoded eta-started - -- "$@" \
        || die "ffmpeg could not encode $format$(ram_hint)"
}
case $format in
    gif)
        encode ffmpeg "${in[@]}" -fps_mode vfr -filter_complex \
            "[0:v]$resize,split[a][b];[a]palettegen=reserve_transparent=1:max_colors=$gif_colors[p];[b][p]paletteuse=dither=$dither:alpha_threshold=128" \
            -loop 0 -final_delay "$final_delay" -f gif "$output" ;;
    mp4)
        # H.264 has no alpha: transparent areas become black
        encode ffmpeg "${in[@]}" "${audio[@]}" -fps_mode vfr \
            -vf "$resize,format=rgba,premultiply=inplace=1,format=yuv420p" \
            -c:v libx264 -preset slow -crf "$crf_x264" -c:a aac -b:a 192k -movflags +faststart -f mp4 "$output" ;;
    webm)
        encode ffmpeg "${in[@]}" "${audio[@]}" -fps_mode vfr -vf "$resize" -pix_fmt yuva420p \
            -c:v libvpx-vp9 -crf "$crf_vp9" -b:v 0 -row-mt 1 -auto-alt-ref 0 -c:a "$(encoder libopus && echo libopus || echo libvorbis)" -b:a 160k -f webm "$output" ;;
    avif)
        # AVIF stores transparency as a second AV1 stream
        encode ffmpeg "${in[@]}" -fps_mode vfr -filter_complex \
            "[0:v]$resize,format=yuva444p,split[c][a];[a]alphaextract[al]" -map "[c]" -map "[al]" \
            -c:v libaom-av1 -crf "$crf_aom" -cpu-used 6 -row-mt 1 -pix_fmt:0 yuv444p "${single[@]}" -f avif "$output" ;;
    png)
        encode ffmpeg "${in[@]}" -vf "$resize" -frames:v 1 -update 1 -f image2 "$output" ;;
    jpg)
        # JPEG has no alpha: transparent areas become white
        encode ffmpeg "${in[@]}" -filter_complex \
            "color=white:s=${out_w}x${out_h},format=rgb24[bg];[0:v]$resize[fg];[bg][fg]overlay=shortest=1:format=auto,scale=out_range=full,format=yuv444p" \
            -c:v mjpeg -q:v "$q_jpeg" -qmin 1 -color_range pc -frames:v 1 -update 1 -f image2 "$output" ;;
    webp)
        if (( still )); then
            encode ffmpeg "${in[@]}" -vf "$resize" -c:v libwebp "${webp_opts[@]}" -frames:v 1 -f webp "$output"
        else
            pix=yuva420p; (( quality < 100 && ! nearest )) || pix=bgra
            encode ffmpeg "${in[@]}" -fps_mode vfr -vf "$resize" -pix_fmt "$pix" -c:v libwebp_anim "${webp_opts[@]}" \
                -loop 0 -f webp "$output"
            webp_last_delay "$output" "$total_ms"
        fi ;;
esac

progress_finish
msg="Saved $(basename "$output") ($(du -h "$output" | cut -f1))"
echo "$msg"
# The notification's actions open the result. It waits for a click in the background, so the
# script itself ends right away; the activation token lets Wayland bring the window forward.
# Percent-encodes a path for a file:// URI (every byte except letters, digits and -._~/)
file_uri_path() {
    local LC_ALL=C s=$1 out="" c i
    for (( i = 0; i < ${#s}; i++ )); do
        c=${s:i:1}
        case $c in [a-zA-Z0-9._~/-]) out+=$c ;; *) printf -v c '%%%02X' "'$c"; out+=$c ;; esac
    done
    printf '%s' "$out"
}
notify_saved() {
    local file dir
    file=$(realpath -- "$output") dir=$(dirname -- "$(realpath -- "$output")")
    if ! notify-send --help 2>/dev/null | grep -q -- '--action'; then
        notify-send -a "Upscale GIF" -i image-x-generic "$msg" "$dir" || true
        return
    fi
    (
        exec 3>&- 4>&- </dev/null >/dev/null 2>&1
        trap - EXIT
        tokfile=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/upscale-gif-token.XXXXXX") || exit 0
        action=$(timeout 1800 notify-send -a "Upscale GIF" -i image-x-generic \
            -A "default=Show in folder" -A "show=Show in folder" -A "open=Open" \
            --activation-token-fd=5 "$msg" "$dir" 5>"$tokfile") || true
        token=$(cat "$tokfile" 2>/dev/null); rm -f "$tokfile"
        export XDG_ACTIVATION_TOKEN=$token DESKTOP_STARTUP_ID=$token
        case $action in
            default | show)
                # The file manager selects the file; if none offers that, open the folder
                local_uri="file://$(file_uri_path "$file")"
                gdbus call --session --dest org.freedesktop.FileManager1 --object-path /org/freedesktop/FileManager1 \
                    --method org.freedesktop.FileManager1.ShowItems "['$local_uri']" "$token" || xdg-open "$dir" ;;
            open) xdg-open "$file" ;;
        esac
    ) &
    disown
}
if [[ ! -t 1 ]] && gui; then notify_saved; fi
